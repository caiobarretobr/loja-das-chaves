{
  "rewrites": [
    {
      "source": "/api/agendamentos/:id",
      "destination": "/api/agendamentos?id=:id"
    },
    {
      "source": "/api/bloqueios/:id",
      "destination": "/api/bloqueios?id=:id"
    },
    {
      "source": "/api/planos/:id",
      "destination": "/api/planos?id=:id"
    },
    {
      "source": "/api/relatorios/:month",
      "destination": "/api/relatorios?month=:month"
    }
  ],
  "headers": [
    {
      "source": "/index.html",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-cache, no-store, must-revalidate"
        }
      ]
    },
    {
      "source": "/sw.js",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-cache, no-store, must-revalidate"
        }
      ]
    },
    {
      "source": "/(.*\\.(?:js|css|png|jpg|jpeg|gif|svg|webp|ico|json|webmanifest))",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=0, must-revalidate"
        }
      ]
    }
  ]
}
